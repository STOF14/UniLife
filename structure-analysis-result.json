    },
    "step5": {
      "action": "MIGRATE TRANSACTIONS",
      "description": "Link transactions to student profiles",
      "sql": "UPDATE transactions SET student_profile_id = (SELECT id FROM student_profiles WHERE user_id = transactions.user_id);"
    }
  }
